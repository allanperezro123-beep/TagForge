<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Tasks (Phase 4). Only what the spec allows: never QUERY_ALL_PACKAGES, SEND_SMS or CALL_PHONE. -->
    <!-- HttpRequest action: plain GET/POST, https by default, only while the runner is on screen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notify action. Runtime permission on Android 13+; the Permission Center explains and requests it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarm and Timer actions through the clock app. Normal permission, granted at install. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- "Silent" ringer mode. Granted by the user on the Do Not Disturb access screen. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Brightness action. A special permission the user grants on the "Modify system settings" screen. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Wi-Fi toggle/join: legacy configuration up to Android 9, network suggestions on Android 10. -->
    <uses-permission
        android:name="android.permission.CHANGE_WIFI_STATE"
        android:maxSdkVersion="29" />

    <!-- UX-B. Each one is requested at runtime, only when the user taps the matching button, and never in the background. -->
    <!-- Scan a QR code with the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Pick a paired Bluetooth device (name and address) instead of typing the address. Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Same list of paired devices on Android 11 and older. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- "Use my current location" in the Location record. One-shot, foreground only. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- CameraX pulls in media3-common, which asks for ACCESS_NETWORK_STATE. Nothing here plays media: not requested. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- NFC is optional: devices without it get the Unsupported state instead of being filtered out. -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!-- Package visibility without QUERY_ALL_PACKAGES: launchable apps (LaunchApp action) and text to speech (Speak action). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: the only network use is the HttpRequest task action. https is the default; a plain http URL
         is allowed solely after an extra warning and a second tap on the confirmation sheet (TK-08). -->
    <application
        android:name=".TagForgeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TagForge.Splash"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Share target (UX-B): "Share > Tag Forge" from a maps app, browser or notes app opens the Write review with the
                shared text as a record. The sender is untrusted: the text is capped and parsed defensively (SharedText), only
                prefills, and nothing is armed or run until the user presses Write on the review step.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Task runner (TK-05). Starts for an NDEF tag of type application/x-tf and ALWAYS shows a confirmation sheet:
            nothing runs by itself. singleTop + onNewIntent so a second scan replaces the pending task; its own empty
            task affinity and no recents entry so it never mixes into the user's tasks; never shown over the lock
            screen (no showWhenLocked / turnScreenOn). exported=true is required for the NFC dispatcher.
        -->
        <activity
            android:name=".feature.taskrunner.TaskRunnerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.TagForge.Translucent">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-tf" />
            </intent-filter>
        </activity>

        <!--
            The task runner as started by this app (W5): same screen, but NOT exported, so the saved-task id and raw NDEF
            bytes it accepts can only come from our own Read tab and Tasks list. The exported entry above ignores them.
        -->
        <activity
            android:name=".feature.taskrunner.InternalTaskRunnerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.TagForge.Translucent" />

        <!-- Quick actions widget (PR-03): Scan and Write buttons only, no tag contents. -->
        <receiver
            android:name=".feature.productivity.widget.QuickScanWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_scan_widget_info" />
        </receiver>

        <!-- Dump export: a temporary read grant on one cache file at a time, never a world-readable path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
