# Copy this file to keystore.properties (git-ignored) and fill it in. NEVER commit keystore.properties or the keystore.
# Steps to create the keystore are in dist/RELEASE.md.
#
# storeFile is relative to the repository root.
storeFile=keystore/tagforge-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=tagforge
keyPassword=CHANGE_ME_KEY_PASSWORD
